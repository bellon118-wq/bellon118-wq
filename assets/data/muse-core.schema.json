{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayflower-sanctuary.example/schemas/muse-core-memory-v0.1.json",
  "title": "Muse-Core Memory Record",
  "description": "Proposed versioned record contract. Not yet connected to a database or API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "characterId",
    "memoryType",
    "content",
    "source",
    "createdAt",
    "privacy",
    "consent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "characterId": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": "string",
      "description": "Pseudonymous user scope; omit for non-user-specific canon."
    },
    "memoryType": {
      "enum": [
        "core",
        "relationship",
        "episodic",
        "symbolic"
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "details": {
          "type": "string",
          "maxLength": 10000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 30
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "owner_approved_canon",
            "user_shared",
            "interaction_summary",
            "system_event"
          ]
        },
        "referenceId": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "enum": [
        "public_canon",
        "private_user",
        "shared_world_event"
      ]
    },
    "consent": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "granted",
            "not_granted",
            "withdrawn",
            "not_required"
          ]
        },
        "purpose": {
          "type": "string",
          "maxLength": 256
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "properties": {
        "relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emotionalIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recurrence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}