{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayflower-sanctuary.local/schemas/characters.schema.json",
  "title": "Mayflower Sanctuary Character Catalogue",
  "type": "object",
  "required": [
    "characters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "status",
          "faction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "faction": {
            "type": "string",
            "minLength": 1
          },
          "publicationStatus": {
            "type": "string"
          },
          "canonVersion": {
            "type": "string"
          },
          "homeLocationId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "artworkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
