{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayflower-sanctuary.local/schemas/games.schema.json",
  "title": "Mayflower Sanctuary Inspiration World Catalogue",
  "type": "object",
  "required": [
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "genre"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "genre": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
