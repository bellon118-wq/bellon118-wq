{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayflower-sanctuary.local/schemas/items.schema.json",
  "title": "Mayflower Sanctuary Item, Currency and Collection Catalogue",
  "type": "object",
  "required": [
    "schemaVersion",
    "items",
    "currencies",
    "collections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "currencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/currency"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "rarity",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "material",
            "consumable",
            "equipment",
            "collectible",
            "quest",
            "cosmetic",
            "other"
          ]
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary",
            "mythic",
            "unclassified"
          ]
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "stackLimit": {
          "type": "integer",
          "minimum": 1
        },
        "sourceQuestIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "characterIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "locationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "currency": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "maximumBalance": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "name",
        "itemIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "itemIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "completionRewardIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
