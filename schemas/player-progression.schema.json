{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayflower-sanctuary.local/schemas/player-progression.schema.json",
  "title": "Mayflower Sanctuary Local Player Progress",
  "type": "object",
  "required": [
    "schemaVersion",
    "playerId",
    "quests",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "playerId": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "quests": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "objectives"
        ],
        "properties": {
          "status": {
            "enum": [
              "not-started",
              "active",
              "completed",
              "abandoned"
            ]
          },
          "objectives": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "completedQuestIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "discoveredLocationIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unlockedRewardRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
