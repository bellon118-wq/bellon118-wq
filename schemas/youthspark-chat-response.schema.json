{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouthSpark Chat Response",
  "type": "object",
  "required": [
    "schemaVersion",
    "reply",
    "usedMemoryIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "usedMemoryIds": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "requestId": {
      "type": "string",
      "maxLength": 100
    },
    "providerLabel": {
      "type": "string",
      "maxLength": 80
    }
  },
  "additionalProperties": false
}